`;

function print(s) { process.stdout.write(s.endsWith('\n') ? s : s + '\n'); return 0; }
function warn(s) { process.stderr.write(`! ${s}\n`); }
/** 7-char sha for a CI-verdict message, or '?' when `ghRunForSha` had none to report (#92). */
function shortSha(sha) { return sha ? String(sha).slice(0, 7) : '?'; }

function main(argv) {
  const cmd = argv[0];
  const rest = argv.slice(1);
  switch (cmd) {
    case 'claim': return cmdClaim(rest);
    case 'release': return cmdRelease(rest);
    case 'solo': return cmdSolo(rest);
    case 'readiness': return cmdReadiness(rest);
    case 'migration-grant': return cmdMigrationGrant(rest);
    case 'claims': return cmdClaims(rest);
    case 'port': return cmdPort(rest);
    case 'ports': return cmdPorts(rest);
    case 'worktree': return cmdWorktree(rest);
    case 'worktrees': return cmdWorktrees(rest);
    case 'ship': return cmdShip(rest);
    case 'landed': return cmdLanded(rest);
    case 'promote': return cmdPromote(rest);
    case 'doctor': return cmdDoctor(rest);
    case 'release-notes': return cmdReleaseNotes(rest);
    case 'release-status': return cmdReleaseStatus(rest);
    case 'template': return cmdTemplate(rest);
    case 'update': return cmdUpdate(rest);
    case 'register': return cmdRegister(rest);
    case 'config': return cmdConfig(rest);
    case undefined:
    case '-h': case '--help': case 'help': return print(HELP_ROOT);
    case '--version': case 'version': return cmdVersion();
    default:
      warn(`Unknown command: ${cmd}`);
      print(HELP_ROOT);
      return 2;
  }
}

/**
 * Entry point, wrapped so the optional local journal (lib/journal.js) gets one record per
 * invocation: argv, exit code, wall-clock duration. Off unless `journal: true` is configured, in
 * which case every line below is a no-op that touches no path.
 *
 * The record is written on EVERY exit path including the failing ones — "which invocations exit
 * non-zero" is one of the questions this exists to answer, so a journal that only logged successes
 * would be worse than none. Journalling happens after the message is printed and can never change
 * the exit code: the CLI's contract is its exit status, and an optional feature does not get to
 * touch it.
 */
{
  const startedAt = Date.now();
  const argv = process.argv.slice(2);
  let code = 0;
  let failure;
  try {
    journal.setCmd(argv);
  } catch (_) { /* optional, never fatal */ }
  try {
    code = main(argv) || 0;
  } catch (e) {
    if (e instanceof UserError) {
      process.stderr.write(`✗ ${e.message}\n`);
      failure = e.message;
    } else {
      process.stderr.write(`✗ ${e.stack || e.message}\n`);
      failure = e.message;
    }
    code = 1;
  }
  try {
    journal.invoked({ argv, exit: code, durationMs: Date.now() - startedAt, error: failure });
  } catch (_) { /* optional, never fatal */ }
  process.exit(code);
}
