#!/usr/bin/env node
'use strict';
/*
 * colab — issue claims, port allocation and optional worktrees for parallel sessions/agents.
 * Plain Node, zero npm dependencies. Shells out to git/gh. State is machine-local at ~/.colab/.
 *
 * See tools/README.md for the full picture. `colab --help` and `colab <cmd> --help` are authoritative.
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');

const state = require('./lib/state');
const git = require('./lib/git');
const ports = require('./lib/ports');
const stamp = require('./lib/stamp');
const squash = require('./lib/squash');
const procs = require('./lib/procs');
const landed = require('./lib/landed');
const notify = require('./lib/notify');
const journal = require('./lib/journal');
const labels = require('./lib/labels');
const records = require('./lib/records');
const teardown = require('./lib/teardown');
const orphanLib = require('./lib/orphan-worktree');
const solo = require('./lib/solo');
const checklist = require('./lib/checklist');
const groupLabels = require('./lib/group-labels');
const shipguard = require('./lib/shipguard');
const migrationGrant = require('./lib/migration-grant');
const {
  HOST, UserError, normIssueNum, issueTag, claimKey, today, nowISO, hoursSince,
  parseArgs, table, shortRepo,
} = require('./lib/util');

// ---------------------------------------------------------------------------
// shared resolution helpers
// ---------------------------------------------------------------------------

/**
 * Best-effort observer push (lib/notify.js). Silent when `notifyUrl` is unset, which is the default.
 *
 * Wrapped in its own try/catch on top of the one inside notify(): every call site here sits AFTER
 * the command's real work has succeeded, so an exception escaping this line would turn a completed
 * claim or a finished teardown into a non-zero exit and a stack trace. Never throws, never prints —
 * a warning about an optional signal is noise on the output of a command that worked.
 */
function pushEvent(action, fields) {
  // Reuse of notify's CALL SITES, not of its delivery: this only tells the local journal which repo
  // the invocation was about, so the invocation record is attributed correctly even when the state
  // diff carried no repo. Nothing here waits on, or knows about, whether an event was sent.
  try { if (fields && fields.repo) journal.noteRepo(fields.repo); } catch (_) { /* optional */ }
  try { notify.notify(state.loadConfig(), action, fields); } catch (_) { /* secondary signal */ }
}

/**
 * Absolute MAIN repo root from --repo or cwd; throws UserError if none.
 *
 * Always the main working tree, never a linked worktree — claims, ports and worktree records are
 * keyed by the main repo path, so resolving to a worktree makes every one of those lookups miss.
 * Running a command from inside the worktree it operates on is the obvious thing to do, and it
 * used to silently produce `(none claimed)`. This normalises both entry points, so `--repo <a
 * worktree path>` is corrected too.
 */
function resolveRepo(opts) {
  let r = opts.repo;
  if (r) {
    r = path.resolve(r);
    if (!fs.existsSync(r)) throw new UserError(`--repo path does not exist: ${opts.repo}`);
    const root = git.mainRepoRoot(r);
    return root || r; // allow a non-git path (local-only claims still work)
  }
  const root = git.mainRepoRoot(process.cwd());
  if (!root) throw new UserError('Not inside a git repo — pass --repo <path>');
  return root;
}

/** All repo roots colab should aggregate reserved ports from: config + current repo (if any). */
function knownRepos(config) {
  const cur = git.mainRepoRoot(process.cwd());
  const extra = cur ? [cur] : [];
  // include repos referenced by state worktrees too
  const st = state.loadState();
  for (const wt of Object.values(st.worktrees)) if (wt.repo) extra.push(wt.repo);
  return extra;
}

/** Find a single claim by issue number, optionally constrained to a repo. */
function findClaim(st, num, repoAbs) {
  const matches = Object.entries(st.claims).filter(([, c]) => normIssueNum(c.issue) === num);
  const scoped = repoAbs ? matches.filter(([k]) => k.startsWith(`${repoAbs}#`)) : matches;
  if (scoped.length === 0) return null;
  if (scoped.length > 1) {
    const repos = scoped.map(([k]) => shortRepo(k.split('#')[0])).join(', ');
    throw new UserError(`Issue #${num} is claimed in multiple repos (${repos}) — disambiguate with --repo`);
  }
  return { key: scoped[0][0], claim: scoped[0][1] };
}

function isGhUsable(repoAbs) {
  return git.ghAvailable() && !!git.originUrl(repoAbs);
}

// ---------------------------------------------------------------------------
// claim ENFORCEMENT — refusal, claim comments, and the tie-break for the
// simultaneous-claim race. See tools/README.md "Claim lifecycle" for the model.
//
// Claims are ENFORCED, not advisory: a claim held by another worktree (locally) or by
// another GitHub user (remotely) blocks a second claim unless --force takes it over
// visibly. The claim comment (feature 2) is both an audit trail on the Issue AND the
// substrate the tie-break (feature 3) parses to settle a true simultaneous race, since
// GitHub offers no atomic check-and-set on labels/assignees.
// ---------------------------------------------------------------------------

// The claim/release comment markers. These strings are a STABLE WIRE FORMAT: the refusal
// path, the tie-break, and future dashboards grep them. Do not reword casually.
const CLAIM_MARK = '🔒 Claimed';
const RELEASE_MARK = '✅ Released';
// Parses a claim comment body back into {worktree, branch, host, date}. The `· <host>` field
// is what lets the tie-break tell two machines of the SAME GitHub user apart. The optional
// trailing `· session <value>` (added 2026-07) is captured separately by SESSION_RE so this
// regex — and every existing parser — stays byte-stable for session-less comments.
const CLAIM_RE = /🔒 Claimed — worktree `([^`]*)` · branch `([^`]*)` · host `([^`]*)` · (\S+)/;
// The `· session <field>` tail, captured as the rest of the line. parseSessionField() then decodes
// the THREE shapes it can take — `[name](url)`, a bare URL, or a bare name — plus the legacy
// plain-URL form written before sessionName existed.
const SESSION_RE = /· session (.+)$/;

/**
 * Resolve the Claude session URL for this invocation: --session flag > COLAB_SESSION env >
 * '' (absent, never an error). Free-form — typically a session URL.
 */
function resolveSession(opts) {
  const s = opts.session || process.env.COLAB_SESSION || '';
  return String(s).trim();
}

/**
 * Resolve the short human session LABEL: --session-name flag > COLAB_SESSION_NAME env > ''.
 * A friendly name (e.g. `colab-handbook`, `pilot-issue-30`) shown in tables instead of a URL tail.
 */
function resolveSessionName(opts) {
  const s = opts.sessionName || process.env.COLAB_SESSION_NAME || '';
  return String(s).trim();
}

/**
 * A `sessionName` with no `session` URL is a HALF-identity, and it is worse than no identity at
 * all: the row reads as owned, yet nothing can join it to a session. `sessionName` is display
 * text; `session` is the only join key a consumer has (worktree.session → its `session_…` tail →
 * the live session). Never match on the name to close the gap — a consumer tried and reverted
 * after a worktree sat beside a live session with a near-identical name and was NOT it.
 *
 * So: WARN at the CREATION paths (claim, worktree new) — the one moment the URL is cheap to
 * supply — and never fail, because some agents genuinely have no session URL.
 */
function warnHalfIdentity(session, sessionName, what, ref) {
  if (!sessionName || session) return;
  warn(`session name "${sessionName}" recorded with NO session URL — this ${what} will read as owned`);
  warn(`  but cannot be traced to a session. The name is display text; the URL is the join key.`);
  if (ref) warn(`  Repair once you have it:  colab worktree tag ${ref} --session <url>`);
}

/** Compact a session URL for display: the `session_…` tail, or the raw value, capped. */
function shortSession(s) {
  if (!s) return '';
  s = String(s);
  const m = s.match(/session_[\w-]+/);
  const v = m ? m[0] : s;
  return v.length > 18 ? v.slice(0, 17) + '…' : v;
}

/**
 * The friendly identity for tables / plain-text messages: prefer the human `sessionName`, fall back
 * to the compacted URL, else '' (callers render '-'). `--json` always carries both raw fields.
 */
function displayIdentity(sessionName, session) {
  if (sessionName) return sessionName;
  if (session) return shortSession(session);
  return '';
}

/**
 * Table cell for the SESSION column. `displayIdentity` alone renders a name-with-no-URL row
 * IDENTICALLY to a fully-identified one — which is the whole defect: the row *looks* owned and
 * joins to nothing. The `(!)` suffix (explained by identityLegend below) is the only place a
 * reader can see the difference without opening state.json. `--json` is untouched: it always
 * carries both raw fields.
 */
function identityCell(sessionName, session) {
  const text = displayIdentity(sessionName, session) || '-';
  return (sessionName && !session) ? `${text} (!)` : text;
}

/** Print the `(!)` legend under a table, only when at least one row carries a half-identity. */
function identityLegend(entries) {
  if (!entries.some((e) => e && e.sessionName && !e.session)) return;
  print('  (!) session NAME with no session URL — reads as owned, links to nothing.');
  print('      Repair:  colab worktree tag <worktree> --session <url>');
}

/** The ` · session …` comment suffix, or '' — keeps the no-identity comment byte-stable. */
function sessionCommentSuffix(session, sessionName) {
  if (sessionName && session) return ` · session [${sessionName}](${session})`; // both → markdown link
  if (session) return ` · session ${session}`;                                  // url only → legacy form
  if (sessionName) return ` · session ${sessionName}`;                          // name only
  return '';
}

/**
 * Decode the `· session <field>` tail of a claim comment into { sessionName, session }. Accepts:
 *   `[name](url)`  → both;  bare `https://…`/`session_…` → url only;  any other bare token → name.
 * The bare-URL branch is exactly the LEGACY format written before sessionName existed, so old
 * comments keep parsing. Returns empty strings when there is no session tail.
 */
function parseSessionField(body) {
  const m = String(body).match(SESSION_RE);
  if (!m) return { sessionName: '', session: '' };
  const v = m[1].trim();
  const link = v.match(/^\[([^\]]*)\]\((.*)\)$/);
  if (link) return { sessionName: link[1], session: link[2] };
  if (/^https?:\/\//.test(v) || /session_[\w-]+/.test(v)) return { sessionName: '', session: v };
  return { sessionName: v, session: '' };
}

/**
 * Worktree lifecycle status, backfilled-on-read: entries created before this field existed (or by
 * an older colab) render as `running`. Values: `running` (default, at create) → `merged` (branch
 * landed on trunk + no live claims; set by ship after B1, or auto-detected by doctor). "Killed" is
 * not a status — teardown removes the entry entirely.
 */
function wtStatus(wt) { return (wt && wt.status) || 'running'; }

/** The exact claim-comment body. Keep in lockstep with CLAIM_RE/parseSessionField and the README. */
function claimCommentBody(wtName, branch, session, sessionName) {
  // `-` for "no branch", matching the worktree field beside it. It used to be the word `trunk`,
  // which read as a branch name that never existed (#53).
  const base = `${CLAIM_MARK} — worktree \`${wtName || '-'}\` · branch \`${branch || '-'}\` · host \`${HOST}\` · ${nowISO()}`;
  return base + sessionCommentSuffix(session, sessionName); // no-identity body stays EXACTLY as before
}

/** Issues whose EXISTING local claim sits on a different worktree than the one we're claiming onto. */
function localClaimConflicts(st, repoAbs, nums, wtName) {
  const want = wtName || null;
  const out = [];
  for (const num of nums) {
    const ex = st.claims[claimKey(repoAbs, num)];
    if (!ex) continue;
    if ((ex.worktree || null) === want) continue; // idempotent — same holder
    // UPGRADE, not a collision: a TRUNK claim (worktree null) held on THIS host is the
    // same session moving its work into a worktree. Refusing it made `colab claim N`
    // followed by `colab worktree new --issues N` — the documented session order —
    // reject the user's own claim. Note the GitHub check below already excludes
    // yourself (`!assignees.includes(myLogin)`); this keeps the local side from being
    // asymmetrically stricter than the remote one.
    // Still a conflict: a DIFFERENT worktree holds it (two sessions on one machine),
    // or the trunk claim belongs to another host.
    if (want !== null && (ex.worktree || null) === null && ex.host === HOST) continue;
    out.push({ num, holder: ex });
  }
  return out;
}

/**
 * Issues GitHub shows as claimed by SOMEONE ELSE: label `in-progress` present AND a non-empty
 * assignee set that does not include us. A read failure (null) is skipped, never treated as free.
 */
function ghClaimConflicts(repoAbs, nums, myLogin) {
  const out = [];
  for (const num of nums) {
    const info = git.ghIssueView(repoAbs, num, ['assignees', 'labels']);
    if (!info) continue; // couldn't read → don't block on a failed read
    const labeled = (info.labels || []).some((l) => l.name === 'in-progress');
    const assignees = (info.assignees || []).map((a) => a.login);
    if (labeled && assignees.length > 0 && !assignees.includes(myLogin)) out.push({ num, assignees });
  }
  return out;
}

/** Print the two-layer refusal and the escape hatches. */
function printRefusal(localConf, ghConf) {
  process.stderr.write('✗ Refusing — one or more issues are already claimed:\n');
  for (const c of localConf) {
    const h = c.holder;
    const id = displayIdentity(h.sessionName, h.session);
    const sess = id ? ` · session ${id}` : '';
    process.stderr.write(
      `  #${c.num} local: worktree "${h.worktree || '-'}" · branch ${h.branch || '-'} · host ${h.host}${sess} · since ${String(h.created).slice(0, 10)}\n`);
  }
  for (const c of ghConf) {
    process.stderr.write(`  #${c.num} GitHub: assigned to ${c.assignees.join(', ')} (labeled in-progress)\n`);
  }
  process.stderr.write('  Re-run with --force to take over, or claim a different issue.\n');
  process.stderr.write('  Stale claims from dead worktrees are freed by: colab doctor --prune\n');
}

/** Announce exactly what --force overrides (a takeover is visible, never silent). */
function printTakeover(localConf, ghConf) {
  for (const c of localConf) {
    const h = c.holder;
    const id = displayIdentity(h.sessionName, h.session);
    const sess = id ? `, session ${id}` : '';
    print(`  --force: taking over #${c.num} from worktree "${h.worktree || '-'}" (host ${h.host}${sess}, since ${String(h.created).slice(0, 10)})`);
  }
  for (const c of ghConf) {
    print(`  --force: taking over #${c.num} from GitHub assignee ${c.assignees.join(', ')}`);
  }
}

/**
 * Live claim comments on an issue = every `🔒 Claimed` not cancelled by a LATER `✅ Released`
 * from the SAME GitHub author. Returns [{login, host, at, identity}], `at` = the comment's real
 * GitHub createdAt (authoritative, sub-second), `identity` = `login@host`.
 */
function liveClaimComments(comments) {
  const sorted = [...comments].sort((a, b) => (a.createdAt < b.createdAt ? -1 : a.createdAt > b.createdAt ? 1 : 0));
  // releases per author login (release comments carry no host — cancellation is by author, per spec)
  const releasesByLogin = new Map();
  for (const c of sorted) {
    if (String(c.body || '').trim().startsWith(RELEASE_MARK)) {
      const login = (c.author && c.author.login) || '';
      if (!releasesByLogin.has(login)) releasesByLogin.set(login, []);
      releasesByLogin.get(login).push(c.createdAt);
    }
  }
  const live = [];
  for (const c of sorted) {
    const body = String(c.body || '').trim();
    const m = body.match(CLAIM_RE);
    if (!m) continue;
    const login = (c.author && c.author.login) || '';
    const host = m[3];
    const { session, sessionName } = parseSessionField(body); // handles [name](url) / url / name / legacy
    const at = c.createdAt;
    const cancelled = (releasesByLogin.get(login) || []).some((r) => r > at);
    if (!cancelled) live.push({ login, host, session, sessionName, at, identity: `${login}@${host}` });
  }
  return live;
}

/**
 * Deterministic verdict on the simultaneous-claim race. Given the issue's comments, our login and
 * host: if a live claim from a DIFFERENT author-or-host is EARLIER than ours → we lost (returns the
 * winner). Exact-timestamp ties break on identity string (lexicographically smaller identity wins),
 * so both racers, reading the same comments, reach the same verdict independently.
 */
function tieBreakVerdict(comments, myLogin, myHost) {
  const live = liveClaimComments(comments);
  const mine = live
    .filter((c) => c.login === myLogin && c.host === myHost)
    .sort((a, b) => (a.at > b.at ? -1 : a.at < b.at ? 1 : 0))[0]; // our latest live claim
  if (!mine) return { lost: false }; // our own comment not visible yet → don't yield to a phantom
  let winner = null;
  for (const c of live) {
    if (c.login === myLogin && c.host === myHost) continue; // never yield to ourselves
    const earlier = c.at < mine.at || (c.at === mine.at && c.identity < mine.identity);
    if (!earlier) continue;
    if (!winner || c.at < winner.at || (c.at === winner.at && c.identity < winner.identity)) winner = c;
  }
  return winner ? { lost: true, winner } : { lost: false };
}

/** Post the claim comment (best-effort: a failure warns but never fails the claim). */
function postClaimComment(repoAbs, num, wtName, branch, session, sessionName) {
  const r = git.ghIssueComment(repoAbs, num, claimCommentBody(wtName, branch, session, sessionName));
  if (!r.ok) warn(`could not post claim comment on #${num} (${r.stderr.split('\n')[0] || r.code}) — claim stands`);
}

/**
 * Post `✅ Released` on an issue, UNLESS it is already CLOSED (a `Closes #N` merge already ended the
 * story). Best-effort. Used by release + worktree rm.
 */
function postReleaseComment(repoAbs, num) {
  const info = git.ghIssueView(repoAbs, num, ['state']);
  if (info && info.state === 'CLOSED') return; // don't chatter on a closed issue
  const r = git.ghIssueComment(repoAbs, num, RELEASE_MARK);
  if (!r.ok) warn(`could not post release comment on #${num} (${r.stderr.split('\n')[0] || r.code})`);
}

/**
 * We lost the race for #num → yield it. Removes our local claim, posts the yield notice, and
 * (only when the winner is a DIFFERENT GitHub user) removes our label + @me assignee. When the
 * winner shares our login (another machine of ours), the GitHub label/assignee is a single shared
 * marker the winner still needs — so we leave it and let the comment layer record the handover.
 */
function yieldIssue(repoAbs, num, winner, myLogin) {
  if (winner.login !== myLogin) {
    const r = git.ghIssueEdit(repoAbs, num, ['--remove-label', 'in-progress', '--remove-assignee', '@me']);
    if (!r.ok) warn(`gh: could not remove our label/assignee on #${num} while yielding (${r.stderr.split('\n')[0] || r.code})`);
  }
  const rc = git.ghIssueComment(repoAbs, num, `${RELEASE_MARK} (yielded — earlier claim by ${winner.identity} wins)`);
  if (!rc.ok) warn(`could not post yield comment on #${num} (${rc.stderr.split('\n')[0] || rc.code})`);
  state.mutate((st) => { delete st.claims[claimKey(repoAbs, num)]; });
}

/**
 * Run the claim comment + tie-break for issues we just claimed on GitHub. Returns the list of
 * issue numbers we LOST (already yielded). `owner` is {wtName, branch, myLogin, session, sessionName}.
 */
function commentAndTieBreak(repoAbs, nums, owner) {
  const lost = [];
  for (const num of nums) {
    postClaimComment(repoAbs, num, owner.wtName, owner.branch, owner.session, owner.sessionName);
    const info = git.ghIssueView(repoAbs, num, ['comments']);
    if (!info || !Array.isArray(info.comments)) continue; // can't read comments → keep the claim
    const verdict = tieBreakVerdict(info.comments, owner.myLogin, HOST);
    if (verdict.lost) {
      yieldIssue(repoAbs, num, verdict.winner, owner.myLogin);
      const w = verdict.winner;
      const id = displayIdentity(w.sessionName, w.session);
      const wsess = id ? ` · session ${id}` : '';
      warn(`Yielded #${num} — an earlier simultaneous claim by ${w.identity}${wsess} wins. Pick another issue.`);
      lost.push(num);
    }
  }
  return lost;
}

// ---------------------------------------------------------------------------
// claim / release / claims
// ---------------------------------------------------------------------------

const HELP_CLAIM = `colab claim <issue> [<issue> ...] [options]

Claim one or more GitHub issues so parallel sessions/agents don't collide.
Writes BOTH local state (fast path) and GitHub (source of truth across machines):
  gh issue edit N --add-assignee @me --add-label in-progress
If gh is unavailable or the repo has no remote, degrades to local-only (and says so).

Multiple issues in one call are claimed atomically onto the SAME worktree/branch
(a group of related issues on one branch is normal practice):
  colab claim 115 114 113 --worktree import-fixes-115-114-113 --branch fix/import-fixes-115-114-113

Claims are ENFORCED, not advisory. Before claiming, colab REFUSES (exit 1) if:
  • LOCAL:  the issue already has a live claim on a DIFFERENT worktree (holder shown), or
  • GITHUB: the issue is labeled in-progress AND assigned to someone who isn't you.
Re-claiming onto the SAME worktree is idempotent (OK). --force takes over either layer,
printing exactly what it overrides. On a successful claim colab posts a "🔒 Claimed" comment
on the Issue; if a simultaneous racer claimed microseconds earlier, the tie-break yields to
them automatically (see tools/README.md "Claim lifecycle").

Options:
  --repo <path>       repo root (default: git root of cwd)
  --worktree <name>   attach these claims to a worktree entity (ports live on the worktree, and
                      this is the key 'colab ship --worktree <name>' looks up FIRST — pass both
                      --worktree and --branch on a worktree session so the claim is found either
                      way; a branch-only claim still works, ship unions both keyed forms (#76))
  --branch <name>     branch these claims are worked on. Default: none (null) — a claim held on
                      the trunk checkout has no branch. Never the word "trunk": that is a role,
                      and a record holding it resolves to no ref (refused, exit 1)
  --session <url>     Claude session URL recorded on the claim + comment (default: COLAB_SESSION env)
  --session-name <s>  short human label shown in tables/messages (default: COLAB_SESSION_NAME env)
  --force             take over a claim held by another worktree / GitHub user (logged, never silent)
`;

function cmdClaim(argv) {
  const opts = parseArgs(argv, {
    values: { '--repo': 'repo', '--worktree': 'worktree', '--branch': 'branch', '--session': 'session', '--session-name': 'sessionName' },
    flags: { '--force': 'force', '-h': 'help', '--help': 'help' },
  });
  if (opts.help || opts._.length === 0) return print(HELP_CLAIM);
  const repoAbs = resolveRepo(opts);
  const nums = opts._.map(normIssueNum);
  // No branch is `null`, never the word "trunk". That literal used to be the default here, and it
  // reached state.json as though it were a branch name: `ship` then matched no claims and merged
  // with no `Closes #N` (#53). Refuse it at the front door too — the message is better here than
  // from the state guard, and `--branch trunk` is always a mistake.
  const branch = opts.branch ? String(opts.branch).trim() : null;
  const bp = records.branchProblem(branch);
  if (bp) throw new UserError(`--branch ${opts.branch}: ${bp}`);
  const wtName = opts.worktree || null;
  const session = resolveSession(opts);
  const sessionName = resolveSessionName(opts);
  warnHalfIdentity(session, sessionName, 'claim', wtName);
  const gh = isGhUsable(repoAbs);
  const myLogin = gh ? git.ghCurrentLogin() : null;

  // ---- REFUSAL (two layers, check-then-refuse) ----
  const localConf = localClaimConflicts(state.loadState(), repoAbs, nums, wtName);
  const ghConf = gh ? ghClaimConflicts(repoAbs, nums, myLogin) : [];
  if (!gh) warn('gh not usable here (no gh auth or no origin remote) — refusal is LOCAL-ONLY');
  if ((localConf.length || ghConf.length)) {
    if (!opts.force) { printRefusal(localConf, ghConf); return 1; }
    printTakeover(localConf, ghConf);
  }

  // ---- claim locally (idempotent on same worktree; --force overwrites a different holder) ----
  const res = state.mutate((st) => {
    if (wtName && !st.worktrees[wtName]) {
      // A stub for a worktree that will be created later. It exists so the claim is not read as an
      // orphan; `colab worktree new` overwrites it with the real record. `status: pending` is what
      // makes the null path HONEST rather than a record claiming a directory it does not have —
      // doctor knows the difference, and a stub that never becomes a worktree is reported as drift.
      st.worktrees[wtName] = { name: wtName, repo: repoAbs, branch, path: null, ports: [], host: HOST, session, sessionName, status: records.PENDING, created: nowISO() };
    }
    const created = [], reclaimed = [];
    for (const num of nums) {
      const key = claimKey(repoAbs, num);
      const ex = st.claims[key];
      if (ex && (ex.worktree || null) === (wtName || null)) { reclaimed.push(num); continue; } // idempotent
      st.claims[key] = { issue: issueTag(num), repo: repoAbs, worktree: wtName, branch, host: HOST, session, sessionName, created: nowISO() };
      created.push(num);
    }
    return { created, reclaimed };
  });

  for (const num of res.reclaimed) print(`#${num} already claimed by this worktree — OK (idempotent)`);

  // ---- GitHub side (outside the lock — network): assign/label, comment, tie-break ----
  let lost = [];
  if (gh) {
    for (const num of res.created) {
      const r = git.ghIssueEdit(repoAbs, num, ['--add-assignee', '@me', '--add-label', 'in-progress']);
      if (r.ok) print(`  gh: #${num} assigned + labeled in-progress`);
      else warn(`gh edit #${num} failed (${r.stderr.split('\n')[0] || r.code}) — local claim stands`);
    }
    lost = commentAndTieBreak(repoAbs, res.created, { wtName, branch, myLogin, session, sessionName });
  } else {
    warn('gh not usable here — claims are LOCAL-ONLY (no comment, no tie-break)');
  }

  const kept = res.created.filter((n) => !lost.includes(n));
  if (kept.length) {
    print(`Claimed ${kept.map((n) => '#' + n).join(' ')} in ${shortRepo(repoAbs)}` +
      (wtName ? ` → worktree "${wtName}"${branch ? ` (branch ${branch})` : ' (no branch yet)'}`
        : (branch ? ` (branch ${branch})` : ' (no worktree, no branch — the trunk checkout)')));
  }
  // One event per issue KEPT — not per command. An issue lost to the tie-break was never ours, and
  // reporting the group as claimed would tell an observer the opposite of what GitHub now says.
  for (const num of kept) pushEvent('claim', { repo: repoAbs, issue: num, worktree: wtName, session, payload: { branch } });
  // Lost any issue to the tie-break → non-zero so the caller picks another.
  return lost.length ? 1 : 0;
}

const HELP_RELEASE = `colab release <issue> [--repo <path>]

Release a single issue: removes the local claim and, if gh is usable, runs
  gh issue edit N --remove-assignee @me --remove-label in-progress
Sibling claims on the same worktree stay alive (a group finishes issues one at a time).
The worktree is NEVER auto-removed here (uncommitted work may exist); if this was the
last claim, the output says the worktree now has zero claims.
`;

function cmdRelease(argv) {
  const opts = parseArgs(argv, {
    values: { '--repo': 'repo' }, flags: { '-h': 'help', '--help': 'help' },
  });
  if (opts.help || opts._.length === 0) return print(HELP_RELEASE);
  const num = normIssueNum(opts._[0]);
  const repoAbs = opts.repo ? resolveRepo(opts) : (git.repoRoot(process.cwd()) || null);

  let found;
  const out = state.mutate((st) => {
    found = findClaim(st, num, repoAbs);
    if (!found) return null;
    delete st.claims[found.key];
    const wtName = found.claim.worktree;
    let remaining = null;
    if (wtName) {
      remaining = Object.values(st.claims).filter((c) => c.worktree === wtName).length;
    }
    return { repo: found.claim.repo, wtName, remaining };
  });

  if (!out) throw new UserError(`No local claim for #${num}` + (repoAbs ? ` in ${shortRepo(repoAbs)}` : ''));

  if (isGhUsable(out.repo)) {
    const r = git.ghIssueEdit(out.repo, num, ['--remove-assignee', '@me', '--remove-label', 'in-progress']);
    if (r.ok) print(`  gh: #${num} unassigned + label removed`);
    else warn(`gh edit #${num} failed (${r.stderr.split('\n')[0] || r.code}) — local claim already removed`);
    postReleaseComment(out.repo, num); // "✅ Released" unless the issue is already CLOSED
  } else {
    warn('gh not usable here — released LOCAL-ONLY');
  }
  print(`Released #${num} from ${shortRepo(out.repo)}`);
  pushEvent('release', { repo: out.repo, issue: num, worktree: out.wtName, session: found.claim.session });
  if (out.wtName && out.remaining === 0) {
    print(`  note: worktree "${out.wtName}" now has ZERO claims (not removed — run: colab worktree rm ${out.wtName})`);
  } else if (out.wtName) {
    print(`  worktree "${out.wtName}" still has ${out.remaining} claim(s)`);
  }
  return 0;
}

// ---------------------------------------------------------------------------
// solo — the entry gate for solo flow (CONVENTIONS.md, Solo flow; #83).
//
// Solo flow lets a `ceremony: light` repo skip pre-filed issue / claim / worktree and commit
// straight to trunk — legal ONLY because the start-side rails (claim discipline, worktree
// isolation) exist to protect OTHER sessions, and a solo session has none. This command is the
// mechanical check that condition actually holds, not the honor system: every rule it enforces
// is read fresh from git + state.json on every call, never assumed from a prior run.
//
// The lock (`state.solo[repoAbs]`) is its own thing, not a claim or a worktree — solo flow makes
// neither, so there is nothing else in state.json a second solo attempt could collide with.
// ---------------------------------------------------------------------------

const HELP_SOLO = `colab solo [--repo <path>] [--force] [--session <url>] [--session-name <name>]
colab solo --done [--repo <path>]

Entry gate for solo flow (CONVENTIONS.md, Solo flow) — legal ONLY on a \`ceremony: light\` repo.
Trunk-direct commits with no pre-filed issue, claim or worktree are safe exactly when nobody
else could be colliding with them; this command checks that mechanically instead of trusting it.

  colab solo            check + LOCK: no live solo session, no worktree, no claim, checked out
                         on trunk, no unpushed branch anywhere, clean tree. Any one held → refuse,
                         full ceremony, no exception.
  colab solo --done     exit check: tree clean AND pushed, then releases the lock.
  colab solo --force    take over a lock THIS command already holds in this repo (e.g. a crashed
                         session) — never bypasses the other checks, only a stale lock of your own.

Not honor system: nothing here is read once and cached — every check re-derives its answer from
git and ~/.colab/state.json on this invocation. The lock is machine-local, one repo at a time.
`;

function cmdSolo(argv) {
  const opts = parseArgs(argv, {
    values: { '--repo': 'repo', '--session': 'session', '--session-name': 'sessionName' },
    flags: { '--done': 'done', '--force': 'force', '-h': 'help', '--help': 'help' },
  });
  if (opts.help) return print(HELP_SOLO);
  const repoAbs = resolveRepo(opts);
  const doc = projectDoc(repoAbs);
  if (doc.ceremony !== 'light') {
    throw new UserError(`solo flow requires \`ceremony: light\` in .github/project.yml — this repo ` +
      `is ${doc.ceremony ? `\`ceremony: ${doc.ceremony}\`` : 'unset (standard)'}. Full ceremony applies ` +
      `(CONVENTIONS.md, Solo flow).`);
  }

  if (opts.done) return cmdSoloDone(repoAbs, doc);

  const st = state.loadState();
  const held = (st.solo || {})[repoAbs];
  if (held && !opts.force) {
    print(`✗ solo already OPEN in ${shortRepo(repoAbs)} — held by ${held.host}` +
      (held.sessionName || held.session ? ` (${displayIdentity(held.sessionName, held.session)})` : '') +
      ` since ${held.since}.`);
    print('  Close it first (colab solo --done), or --force if it is stale (that host crashed/is gone).');
    return 1;
  }

  const trunk = resolveTrunk(repoAbs, doc);
  const problems = solo.entryProblems(st, repoAbs, trunk);
  if (problems.length) {
    print(`✗ solo refused in ${shortRepo(repoAbs)} — full ceremony required:`);
    for (const p of problems) print(`  - ${p}`);
    return 1;
  }

  const session = resolveSession(opts);
  const sessionName = resolveSessionName(opts);
  warnHalfIdentity(session, sessionName, 'solo lock', null);

  state.mutate((s) => {
    s.solo = s.solo || {};
    s.solo[repoAbs] = { host: HOST, session, sessionName, since: nowISO() };
  });

  // No pushEvent here: `solo` is not in notify.js's ACTION_KIND (closed vocabulary, agreed with the
  // receiver per action — same reasoning as readiness's commented-out emission, #45/#46). This lock
  // is COLAB-LOCAL and already in state.json for anything polling it; inventing a kind unilaterally
  // is exactly what that module's contract forbids.
  print(`✓ solo flow OPEN in ${shortRepo(repoAbs)} (trunk "${trunk}") — commit straight to trunk with`);
  print('  Conventional Commits; file an Issue only for a decision that outlives this session.');
  print('  `colab solo --done` when finished.');
  return 0;
}

function cmdSoloDone(repoAbs, doc) {
  const st = state.loadState();
  const held = (st.solo || {})[repoAbs];
  if (!held) throw new UserError(`No solo lock held in ${shortRepo(repoAbs)} — nothing to release.`);

  const trunk = resolveTrunk(repoAbs, doc);
  const problems = solo.exitProblems(repoAbs, trunk);
  if (problems.length) {
    print(`✗ solo --done refused in ${shortRepo(repoAbs)}:`);
    for (const p of problems) print(`  - ${p}`);
    return 1;
  }

  state.mutate((s) => {
    if (s.solo) delete s.solo[repoAbs];
  });
  print(`✓ solo flow CLOSED in ${shortRepo(repoAbs)} — tree clean, pushed, lock released.`);
  return 0;
}

// ---------------------------------------------------------------------------
// readiness — colab owns the deps-checked marker (CONVENTIONS.md §5)
// ---------------------------------------------------------------------------

const HELP_READINESS = `colab readiness <issue> [--clear] [--mechanical] [--repo <path>]

Own the readiness marker (§5) — the deps-checked label meaning "dependencies verified,
no open blocker". Making colab the writer (rather than a raw \`gh issue edit\`) is the point:
the write is journaled like every other colab action, the label name comes from one place
(tools/lib/labels.js, shared with the audit), and the observer event falls out of the same
pushEvent() path the other state changes use (kind readiness.marked, agreed with the receiver).

  colab readiness <N>            add deps-checked    (set ONLY after actually looking)
  colab readiness <N> --clear    remove deps-checked (a new blocker, or the issue reopened)

Runs the label edit for you:  gh issue edit N --add-label deps-checked  (or --remove-label).
The marker lives on GitHub, visible from any machine to the readiness gate that reads it, so
without a usable gh + remote this command REFUSES (exit 1) rather than report a success that
wrote nothing anyone can see — there is deliberately no local-only fallback. Likewise, if the
repo never got the deps-checked label (adopted before it entered the set), the add REFUSES with
an actionable message pointing at handbook-sync — never a success on a write that did not land.

The label is DERIVED state, only ever as fresh as this last check: whoever adds a blocker
clears it. Prefer leaving it off to leaving it wrong (CONVENTIONS.md §5).

  colab readiness <N> --mechanical           add graph-empty    (reads blockedBy itself)
  colab readiness <N> --mechanical --clear   remove graph-empty

--mechanical writes a SEPARATE, weaker marker — CONVENTIONS.md §5 "Mechanical readiness"
(#69). It never touches deps-checked, and deps-checked never touches graph-empty: the two
claims must stay distinguishable, because a mechanical read cannot see a blocker described
only in prose. It re-derives its own evidence rather than trusting the caller — it reads
\`blockedBy\` via \`gh issue view\` on every run — and REFUSES rather than write the label if
that read comes back non-empty or unreadable. On a successful ADD it also posts a receipt
comment naming exactly what was read and when, so the claim is auditable rather than
assumed. graph-empty is opt-in per repo (create the label yourself; adoption/sync/the audit
do not provision it — same treatment as \`tracking\`), and it emits no observer event: the
receiver has agreed \`readiness.marked\` to mean deps-checked specifically, and this is not that.
`;

function cmdReadiness(argv) {
  const opts = parseArgs(argv, {
    values: { '--repo': 'repo' },
    flags: { '--clear': 'clear', '--mechanical': 'mechanical', '-h': 'help', '--help': 'help' },
  });
  if (opts.help || opts._.length === 0) return print(HELP_READINESS);
  const num = normIssueNum(opts._[0]);
  const repoAbs = opts.repo ? resolveRepo(opts) : (git.repoRoot(process.cwd()) || null);
  if (!repoAbs) throw new UserError('not inside a git repo — pass --repo <path>');

  // No local fallback, on purpose. A claim can degrade to local-only because it also has a fast
  // local copy; the readiness marker has only one home — the provider, where the gate that reads it
  // can see it from any machine (CONVENTIONS.md §5). Writing it "local-only" would be invisible to
  // the one reader it exists for, so absent gh this command refuses instead of faking success.
  if (!isGhUsable(repoAbs)) {
    throw new UserError(`gh not usable here (no gh auth or no origin remote) — the ${labels.READINESS_LABEL} marker lives on GitHub and cannot be written local-only`);
  }

  if (opts.mechanical) return cmdReadinessMechanical(repoAbs, num, opts);

  const r = git.ghIssueEdit(repoAbs, num, labels.readinessLabelArgs({ clear: opts.clear }));
  if (!r.ok) {
    // The doubly-silent failure of #49: a repo that adopted the conventions before `deps-checked`
    // entered the set never back-filled it, so the ADD hits a label that does not exist. gh's raw
    // error ("'deps-checked' not found") sends an operator re-running triage, which re-prints its
    // cached verdict WITHOUT retrying — nothing ever moves. Name the cause and its fix instead.
    // Only on ADD: clearing a label the repo lacks already leaves readiness UNCHECKED, the goal.
    const hint = opts.clear ? null : labels.readinessMissingLabelHint(git.ghListLabels(repoAbs));
    throw new UserError(hint || `gh edit #${num} failed (${r.stderr.split('\n')[0] || r.code})`);
  }
  print(opts.clear
    ? `Cleared ${labels.READINESS_LABEL} on #${num} in ${shortRepo(repoAbs)} — readiness is now UNCHECKED`
    : `Marked #${num} in ${shortRepo(repoAbs)} ${labels.READINESS_LABEL} — verified: no open blocker`);

  // colab is now the writer of the deps-checked marker, so it owns the event too. The receiver has
  // agreed the kind `readiness.marked` and ingests this as an optimistic "ready" hint that bridges
  // the provider's read-after-write lag (#46 §1, following #45 §1). Best-effort as ever: unset
  // notifyUrl is silence, a dead receiver costs nothing, and the label above is already written.
  pushEvent('readiness', { repo: repoAbs, issue: num, payload: { state: opts.clear ? 'unchecked' : 'checked' } });
  return 0;
}

/**
 * The --mechanical half of `colab readiness` (#69). Split out rather than interleaved with the
 * deps-checked path above so the two writers can never accidentally share a branch of logic —
 * CONVENTIONS.md §5 is explicit that the two claims must stay distinguishable at every layer,
 * not just in the label name.
 */
function cmdReadinessMechanical(repoAbs, num, opts) {
  if (opts.clear) {
    const r = git.ghIssueEdit(repoAbs, num, labels.mechanicalReadinessLabelArgs({ clear: true }));
    if (!r.ok) throw new UserError(`gh edit #${num} failed (${r.stderr.split('\n')[0] || r.code})`);
    print(`Cleared ${labels.MECHANICAL_READINESS_LABEL} on #${num} in ${shortRepo(repoAbs)}`);
    return 0;
  }

  // Opt-in label (CONVENTIONS.md §5): unlike deps-checked, adoption/sync never provision this
  // one, so an absent label here is the ordinary case for a repo that has not opted in — point
  // at self-provisioning, never at handbook-sync (there is nothing for sync to back-fill).
  const present = git.ghListLabels(repoAbs);
  if (present && !present.includes(labels.MECHANICAL_READINESS_LABEL)) {
    throw new UserError(`this repo has no \`${labels.MECHANICAL_READINESS_LABEL}\` label — it is opt-in `
      + `(CONVENTIONS.md §5, Mechanical readiness). Create it to use the mechanical lane: `
      + `gh label create ${labels.MECHANICAL_READINESS_LABEL} --color BFDADC --description "Mechanical check: the recorded dependency graph reads empty — NOT a substitute for deps-checked"`);
  }

  // Re-derive the evidence ourselves — the whole point of #69's resolution is that this marker
  // may never be written on a caller's say-so, only on what the API says right now.
  const info = git.ghIssueView(repoAbs, num, ['blockedBy']);
  if (!info || !info.blockedBy || typeof info.blockedBy.totalCount !== 'number') {
    throw new UserError(`could not read #${num}'s blockedBy graph — refusing to write ${labels.MECHANICAL_READINESS_LABEL} on an unmeasured read`);
  }
  if (info.blockedBy.totalCount > 0) {
    throw new UserError(`#${num} has ${info.blockedBy.totalCount} recorded blocker(s) — ${labels.MECHANICAL_READINESS_LABEL} asserts an EMPTY graph, so this read does not qualify`);
  }

  const r = git.ghIssueEdit(repoAbs, num, labels.mechanicalReadinessLabelArgs({ clear: false }));
  if (!r.ok) throw new UserError(`gh edit #${num} failed (${r.stderr.split('\n')[0] || r.code})`);

  // The receipt (#69, framing 2): auditable rather than assumed. Best-effort — the label write
  // above already landed, and a comment that fails to post costs a human re-deriving "when was
  // this checked" from the label's own timestamp, not a lost fact.
  const ts = new Date().toISOString();
  git.ghIssueComment(repoAbs, num,
    `Mechanical readiness check (\`colab readiness --mechanical\`): \`blockedBy\` totalCount = 0, read ${ts}. `
    + `This confirms the ENCODED graph only — it cannot see a blocker described only in prose. Applied \`${labels.MECHANICAL_READINESS_LABEL}\`, not \`${labels.READINESS_LABEL}\`.`);

  print(`Marked #${num} in ${shortRepo(repoAbs)} ${labels.MECHANICAL_READINESS_LABEL} — blockedBy reads empty (receipt posted)`);
  // Deliberately no pushEvent: the receiver has agreed `readiness.marked` to mean deps-checked
  // specifically (#45, #46); this marker is not that claim and gets no event until a kind for it
  // is separately agreed (CONVENTIONS.md §5, Mechanical readiness).
  return 0;
}

// ---------------------------------------------------------------------------
// migration-grant (#98) — a per-issue, human-only, branch-bound, expiring exemption to `ship`'s
// no-new-migrations precondition. See tools/lib/migration-grant.js for the verdict logic and
// CONVENTIONS.md §5 (Migration exemption) for the full design. This section is the gh I/O only.
// ---------------------------------------------------------------------------

const HELP_MIGRATION_GRANT = `colab migration-grant <issue> --branch <branch> [--repo <path>]
colab migration-grant <issue> --revoke [--repo <path>]
colab migration-grant --list [--json] [--repo <path>]

Own the migration-grant marker (#98) — a human-only, per-issue, BRANCH-BOUND, EXPIRING exemption
to \`colab ship\`'s no-new-migrations precondition, for the one legitimate class of work that gate
otherwise makes permanently un-shippable unattended: an issue whose entire deliverable IS a schema
change. Nothing else can produce a grant — no --force on ship, no project.yml field, no inference
from an issue's content, age or park count. A human act on the issue is the whole answer.

  colab migration-grant <N> --branch <branch>    grant #N an exemption, bound to <branch>
  colab migration-grant <N> --revoke             revoke #N's grant (idempotent — safe if none exists)
  colab migration-grant --list [--json]          list every issue with a live grant right now

HUMAN-ONLY, ENFORCED: both grant and revoke REFUSE (exit 1) unless COLAB_HUMAN=1 is set in the
environment — the identical bar \`colab promote\` already holds a production promotion to. No
field, flag or project.yml value can lower it. This check runs BEFORE any network call.

The marker is TWO parts, both required for a grant to read as live:
  - the \`${labels.MIGRATION_GRANT_LABEL}\` label — applying it requires GitHub write/triage
    permission, so a drive-by commenter on a public repo cannot manufacture a grant.
  - a \`${migrationGrant.GRANT_MARK}\` comment on the issue — carries the BRANCH the grant is bound
    to (a label name cannot: GitHub caps it at 50 chars), who granted it, and when.
\`colab ship\` honors a grant only when BOTH are present, the issue is still OPEN, the comment's
branch matches the branch being shipped, and the comment's author is a repo owner/member/
collaborator. It EXPIRES the moment the issue closes — there is no separate expiry date.

On a GROUP branch (several claimed issues), EVERY issue must carry a valid grant for THIS branch —
a migration cannot be mechanically attributed to one member, so one granted issue must never
smuggle an unreviewed migration in for its siblings.

Revoking removes the label FIRST (the gate is restored the same minute) and posts a
\`${migrationGrant.REVOKE_MARK}\` receipt after. Revocation is not scoped to one branch or one
grantor — any revoke comment cancels every live grant on that issue, because a safety gate should
fail toward "closed" if either half only partially lands.

There is deliberately no local-only fallback: without a usable \`gh\`, every subcommand here REFUSES
rather than write (or read) something invisible to the machine \`ship\` might later run on.

Options:
  --branch <branch>  required for --branch grants; a grant is never inferred from HEAD
  --revoke           revoke instead of grant
  --list             list every issue with a live grant, instead of granting/revoking
  --json             (with --list) machine-readable output
  --repo <path>       repo root (default: git root of cwd)
`;

function cmdMigrationGrant(argv) {
  const opts = parseArgs(argv, {
    values: { '--repo': 'repo', '--branch': 'branch' },
    flags: { '--revoke': 'revoke', '--list': 'list', '--json': 'json', '-h': 'help', '--help': 'help' },
  });
  if (opts.help) return print(HELP_MIGRATION_GRANT);
  if (opts.list) return cmdMigrationGrantList(opts);
  if (opts._.length === 0) return print(HELP_MIGRATION_GRANT);
  const num = normIssueNum(opts._[0]);

  // HUMAN-ONLY, first — before resolveRepo, before any gh call, before the issue is even read.
  // Matches cmdPromote's COLAB_HUMAN=1 bar exactly: the only verified "human-only, enforced not
  // documented" mechanism in this codebase. Running this check first means the property is
  // assertable by a test against a fixture with no `gh` at all (tools/lib/ship-migration-grant.test.js).
  if (process.env.COLAB_HUMAN !== '1') {
    process.stderr.write(`✗ Refusing: ${opts.revoke ? 'revoking' : 'creating'} a migration grant requires a human.\n`);
    process.stderr.write('  Re-run with COLAB_HUMAN=1. (No field, flag or project.yml value can lower this bar.)\n');
    return 1;
  }

  const repoAbs = opts.repo ? resolveRepo(opts) : (git.repoRoot(process.cwd()) || null);
  if (!repoAbs) throw new UserError('not inside a git repo — pass --repo <path>');

  // No local fallback, on purpose — same reasoning as `colab readiness`: the grant lives on
  // GitHub, visible from any machine to the gate that reads it (ship may run on a DIFFERENT
  // machine than the one that granted). Writing or reading it local-only would be invisible to
  // the one reader it exists for.
  if (!isGhUsable(repoAbs)) {
    throw new UserError('gh not usable here (no gh auth or no origin remote) — a migration grant lives on the tracker, visible from any machine to the gate that reads it, and there is deliberately no local-only fallback');
  }

  return opts.revoke ? cmdMigrationGrantRevoke(repoAbs, num) : cmdMigrationGrantCreate(repoAbs, num, opts);
}

function cmdMigrationGrantCreate(repoAbs, num, opts) {
  if (!opts.branch) {
    throw new UserError('--branch <branch> is required — a grant is bound to one branch, never inferred from the current checkout');
  }
  if (!git.branchExists(repoAbs, opts.branch)) {
    throw new UserError(`branch "${opts.branch}" does not resolve to a ref (locally or on origin) — refusing to bind a grant to a name nothing exists at`);
  }

  const info = git.ghIssueView(repoAbs, num, ['state', 'labels']);
  if (!info) throw new UserError(`could not read #${num} from the tracker — refusing to write a grant blind`);
  if (info.state !== 'OPEN') {
    throw new UserError(`#${num} is ${info.state} — a grant expires the instant its issue closes, so granting a closed one would do nothing (CONVENTIONS.md §5, Migration exemption)`);
  }

  const present = git.ghListLabels(repoAbs);
  if (present && !present.includes(labels.MIGRATION_GRANT_LABEL)) {
    throw new UserError(labels.migrationGrantMissingLabelHint(present)
      || `this repo has no \`${labels.MIGRATION_GRANT_LABEL}\` label`);
  }

  const editR = git.ghIssueEdit(repoAbs, num, labels.migrationGrantLabelArgs({}));
  if (!editR.ok) throw new UserError(`gh edit #${num} failed (${editR.stderr.split('\n')[0] || editR.code})`);

  // The comment is the AUTHORITY (it carries the branch binding) — not best-effort, unlike a
  // claim comment. A label with no live comment reads "granted" to a human and correctly REFUSES
  // in ship, which is the worst of both: looks done, does nothing. Roll the label back rather than
  // leave that state.
  const iso = nowISO();
  const commentR = git.ghIssueComment(repoAbs, num, migrationGrant.grantCommentBody(opts.branch, HOST, iso));
  if (!commentR.ok) {
    git.ghIssueEdit(repoAbs, num, labels.migrationGrantLabelArgs({ clear: true }));
    throw new UserError(`label applied but the grant comment failed to post (${commentR.stderr.split('\n')[0] || commentR.code}) — rolled the label back so this does not read as granted. Re-run.`);
  }

  print(`Granted #${num} in ${shortRepo(repoAbs)} a migration exemption for branch "${opts.branch}".`);
  print(`  This covers ONLY this branch, and expires the moment #${num} closes.`);
  print(`  Revoke any time: colab migration-grant ${num} --revoke`);
  // Deliberately no pushEvent — see HELP_SHIP's JSON note: no receiver-agreed kind exists for
  // this yet, and both markers are already visible on the tracker from any machine.
  return 0;
}

function cmdMigrationGrantRevoke(repoAbs, num) {
  const info = git.ghIssueView(repoAbs, num, ['state', 'labels', 'comments']);
  if (!info) throw new UserError(`could not read #${num} from the tracker`);
  const labelNames = (info.labels || []).map((l) => (l && typeof l === 'object' ? l.name : l));
  const hasLabel = labelNames.includes(labels.MIGRATION_GRANT_LABEL);
  const live = migrationGrant.liveGrants(info.comments);

  if (!hasLabel && live.length === 0) {
    print(`No live migration grant on #${num} in ${shortRepo(repoAbs)} — nothing to revoke.`);
    return 0;
  }

  // Remove the label FIRST — the mirror image of grant's order. Grant does the weak half first
  // (label) and rolls back on comment failure; revoke does the GATE-RESTORING half first, because
  // the safe state to fail toward here is "already revoked," not "still granted."
  if (hasLabel) {
    const r = git.ghIssueEdit(repoAbs, num, labels.migrationGrantLabelArgs({ clear: true }));
    if (!r.ok) {
      throw new UserError(`could not remove ${labels.MIGRATION_GRANT_LABEL} on #${num} (${r.stderr.split('\n')[0] || r.code}) — the gate is NOT yet restored; retry`);
    }
  }

  const branch = live.length ? live[live.length - 1].branch : '(no live grant found)';
  const commentR = git.ghIssueComment(repoAbs, num, migrationGrant.revokeCommentBody(branch, HOST, nowISO()));
  if (!commentR.ok) {
    warn(`label removed (the ship gate IS restored) but the revoke receipt failed to post (${commentR.stderr.split('\n')[0] || commentR.code}) — post it by hand for the audit trail:`);
    warn(`  gh issue comment ${num} --body "${migrationGrant.REVOKE_MARK} — branch \\\`${branch}\\\` · host \\\`${HOST}\\\` · ${nowISO()}"`);
  }

  print(`Revoked #${num}'s migration grant in ${shortRepo(repoAbs)} — the ship gate is restored.`);
  return 0;
}

function cmdMigrationGrantList(opts) {
  const repoAbs = opts.repo ? resolveRepo(opts) : (git.repoRoot(process.cwd()) || null);
  if (!repoAbs) throw new UserError('not inside a git repo — pass --repo <path>');
  if (!isGhUsable(repoAbs)) {
    throw new UserError('gh not usable here (no gh auth or no origin remote) — cannot list migration grants');
  }

  // null (a failed read) MUST refuse rather than report an empty table — "no outstanding grants"
  // printed after a failed read is the single most dangerous wrong answer this surface can give.
  const hits = git.ghIssueListByLabel(repoAbs, labels.MIGRATION_GRANT_LABEL, 'open', ['number', 'title']);
  if (hits === null) {
    throw new UserError(`could not read ${labels.MIGRATION_GRANT_LABEL}-labeled issues from the tracker`);
  }

  const grants = [];
  const stale = [];
  for (const h of hits) {
    const info = git.ghIssueView(repoAbs, h.number, ['state', 'labels', 'comments']);
    const live = info ? migrationGrant.liveGrants(info.comments) : [];
    if (live.length === 0) { stale.push(h.number); continue; }
    const g = live[live.length - 1];
    grants.push({ issue: h.number, title: h.title, branch: g.branch, by: g.login, authorAssociation: g.authorAssociation, at: g.at });
  }

  if (opts.json) {
    return print(JSON.stringify({ repo: shortRepo(repoAbs), label: labels.MIGRATION_GRANT_LABEL, grants, stale }, null, 2));
  }

  if (grants.length === 0 && stale.length === 0) {
    print(`no outstanding migration grants in ${shortRepo(repoAbs)}`);
    return 0;
  }
  print(table(
    grants.map((g) => [String(g.issue), g.branch, g.by || '(unknown)', g.at, g.title]),
    ['ISSUE', 'BRANCH', 'GRANTED BY', 'WHEN', 'TITLE'],
  ));
  if (stale.length) {
    print('');
    for (const n of stale) warn(`#${n} carries the ${labels.MIGRATION_GRANT_LABEL} label but has NO live grant comment — stale state, looks owned and joins to nothing. Revoke or re-grant.`);
  }
  return 0;
}

const HELP_CLAIMS = `colab claims [--json] [--sync]

List all local claims, grouped by worktree.
  --json    machine-readable output
  --sync    reconcile local state against GitHub (per repo). ADD-ONLY by default: issues
            assigned to you AND labeled in-progress on GitHub but missing locally are added.
            Local claims are NEVER removed unless you also pass --prune.
  --prune   (with --sync) also REMOVE local claims for issues GitHub no longer shows as
            assigned+in-progress, printing exactly what is removed and why.

Removal is opt-in because a successful-but-partial GitHub response (rate limit, paging)
is indistinguishable from a complete one, so a destructive reconcile must be deliberate.
Repos gh can't reach are skipped entirely (never treated as "no claims").
`;

function cmdClaims(argv) {
  const opts = parseArgs(argv, { flags: { '--json': 'json', '--sync': 'sync', '--prune': 'prune', '-h': 'help', '--help': 'help' } });
  if (opts.help) return print(HELP_CLAIMS);
  if (opts.prune && !opts.sync) throw new UserError('--prune only applies together with --sync');
  if (opts.sync) syncClaims({ prune: !!opts.prune });

  const st = state.loadState();
  if (opts.json) { print(JSON.stringify(st.claims, null, 2)); return 0; }

  const claims = Object.values(st.claims);
  if (claims.length === 0) { print('No active claims.'); return 0; }

  // group by worktree (null → "(trunk / no worktree)")
  const groups = new Map();
  for (const c of claims) {
    const g = c.worktree || '(trunk / no worktree)';
    if (!groups.has(g)) groups.set(g, []);
    groups.get(g).push(c);
  }
  for (const [g, cs] of groups) {
    const wt = st.worktrees[g];
    const portStr = wt && wt.ports.length ? ` ports:${wt.ports.join(',')}` : '';
    print(`\n▸ ${g}${portStr}`);
    const rows = cs.map((c) => [c.issue, shortRepo(c.repo), c.branch || '-', c.host, identityCell(c.sessionName, c.session), c.created.slice(0, 10)]);
    print(table(rows, ['ISSUE', 'REPO', 'BRANCH', 'HOST', 'SESSION', 'SINCE']).split('\n').map((l) => '  ' + l).join('\n'));
    identityLegend(cs);
  }
  return 0;
}

function syncClaims({ prune = false } = {}) {
  if (!git.ghAvailable()) { warn('gh not available — --sync skipped'); return; }
  const st = state.loadState();
  // repos represented locally + repos with an origin
  const repos = new Set(Object.values(st.claims).map((c) => c.repo));
  const cur = git.repoRoot(process.cwd());
  if (cur) repos.add(cur);

  const added = [], removed = [];
  for (const repoAbs of repos) {
    if (!git.originUrl(repoAbs)) continue;
    const assigned = git.ghAssignedIssues(repoAbs);
    // A repo gh can't reach is SKIPPED — never treated as "GitHub shows no claims"
    // (that guard is exactly why removal must be opt-in: a partial/failed read must not delete).
    if (assigned === null) { warn(`gh could not list issues for ${shortRepo(repoAbs)} — skipped`); continue; }
    const assignedSet = new Set(assigned);
    // GH → local: ADD missing (always)
    for (const num of assignedSet) {
      const key = claimKey(repoAbs, num);
      state.mutate((s) => {
        if (!s.claims[key]) {
          // No branch is knowable from GitHub — an assignee + label says nothing about where the
          // work sits. `null` says exactly that; the word "trunk" used to, and lied (#53).
          s.claims[key] = { issue: issueTag(num), repo: repoAbs, worktree: null, branch: null, host: HOST, created: nowISO() };
          added.push(`+#${num} ${shortRepo(repoAbs)} (assigned+in-progress on GitHub, missing locally)`);
        }
      });
    }
    // local → GH: REMOVE stale local claims ONLY when --prune is given
    if (prune) {
      const localForRepo = Object.entries(st.claims).filter(([k]) => k.startsWith(`${repoAbs}#`));
      for (const [key, c] of localForRepo) {
        const num = normIssueNum(c.issue);
        if (!assignedSet.has(num)) {
          state.mutate((s) => {
            if (s.claims[key]) { delete s.claims[key]; removed.push(`-#${num} ${shortRepo(repoAbs)} (no longer assigned+in-progress on GitHub)`); }
          });
        }
      }
    }
  }

  if (added.length) { print('Sync — added from GitHub:'); added.forEach((c) => print('  ' + c)); }
  if (prune) {
    if (removed.length) { print('Sync — pruned local claims:'); removed.forEach((c) => print('  ' + c)); }
    else if (!added.length) print('Sync: nothing to add or prune — already in agreement with GitHub.');
  } else {
    if (!added.length) print('Sync: nothing to add (add-only; pass --prune to also remove stale local claims).');
    else print('  (add-only — pass --prune to also remove local claims GitHub no longer shows)');
  }
}

